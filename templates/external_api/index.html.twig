{% extends 'base.html.twig' %}

{% block body %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn">Submit</button>
    {{ form_end(form) }}

    {% if forecast_data %}
        <h2>Data from Open Meteo</h2>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Max Temperature</th>
                    <th>Min Temperature</th>
                    <th>Precipitation (mm)</th>
                </tr>
            </thead>
            <tbody>
                {% for i in 0..forecast_data.daily.time|length-1 %}
                    <tr>
                        <td>{{ forecast_data.daily.time[i] }}</td>
                        <td>{{ forecast_data.daily.temperature_2m_max[i] }}</td>
                        <td>{{ forecast_data.daily.temperature_2m_min[i] }}</td>
                        <td>{{ forecast_data.daily.precipitation_sum[i] }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
